{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(|media-facade|led-install|media-facade-content|showcase|company|quote|data-media-art|landing|rental|pieces|interactive|ai-video|en|en/services|en/works|en/studio|en/rental|en/contact)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(admin|client|login|studio)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/works/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/play",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/tv",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/play",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/studio-classic",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/tools",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/landing",
      "destination": "/company",
      "permanent": true
    },
    {
      "source": "/mediabox",
      "destination": "/rental",
      "permanent": true
    },
    {
      "source": "/interactive",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/pieces",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/ai-video",
      "destination": "/media-facade-content#ai-video",
      "permanent": true
    }
  ]
}
